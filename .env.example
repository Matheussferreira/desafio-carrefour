# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# RabbitMQ
RABBITMQ_USER=rabbit
RABBITMQ_PASS=rabbit

# JWT — troque em produção
JWT_SECRET=dev-secret-change-in-production

# Fuso do negócio
TZ=America/Sao_Paulo

# Cookie do Erlang do RabbitMQ (qualquer valor fixo para ambiente local)
RABBITMQ_ERLANG_COOKIE=cookie-local-dev
