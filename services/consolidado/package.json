{
  "name": "consolidado",
  "version": "1.0.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "test": "jest --forceExit",
    "test:unit": "jest --forceExit",
    "test:integration": "jest --config jest.integration.config.ts --runInBand --forceExit",
